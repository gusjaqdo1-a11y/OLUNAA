# Required: MongoDB connection used by Prisma (MongoDB Atlas recommended)
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER/olunaa?retryWrites=true&w=majority"

# Ably Realtime — server-side only; never expose this key in the Android app/browser
ABLY_API_KEY=""

# LiveKit Cloud — server-side only; required for real voice/video calls
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Firebase Cloud Messaging — server-side service-account JSON, not google-services.json
FIREBASE_PROJECT_ID="olunaa-52ff0"
FIREBASE_SERVICE_ACCOUNT_JSON=""
